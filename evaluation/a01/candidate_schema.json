{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oncopilot/a01-candidate.schema.json",
  "title": "OncoPilot A01 candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "candidate_id", "candidate_type", "is_real_model_output", "facts", "changes", "missing_information", "tasks", "safety"],
  "properties": {
    "case_id": { "const": "A01" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_type": { "type": "string", "minLength": 1 },
    "is_real_model_output": { "type": "boolean" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "code", "value", "unit", "source_ids"],
        "properties": {
          "fact_id": { "type": "string" },
          "code": { "enum": ["WBC", "ANC", "HGB", "PLT"] },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "code", "direction", "from", "to", "source_ids"],
        "properties": {
          "change_id": { "type": "string" },
          "code": { "enum": ["WBC", "ANC", "HGB", "PLT"] },
          "direction": { "enum": ["up", "down", "unchanged"] },
          "from": { "type": "number" },
          "to": { "type": "number" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["missing_id", "label"],
        "properties": { "missing_id": { "type": "string" }, "label": { "type": "string" } }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "objective", "status"],
        "properties": {
          "task_id": { "type": "string" },
          "objective": { "enum": ["verify_current_vitals_and_symptoms", "verify_report_values_and_source", "request_supervisor_review_before_action"] },
          "status": { "const": "pending_human_confirmation" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_diagnosis", "specific_treatment", "mark_action_completed", "human_review_required"],
      "properties": {
        "auto_diagnosis": { "const": false },
        "specific_treatment": { "const": false },
        "mark_action_completed": { "const": false },
        "human_review_required": { "const": true }
      }
    }
  }
}
